/* === Carnet de compagnonnage — feuille de style Dompdf ===
   Palette sobre : bleu institutionnel, gris neutres, pastilles de statut discrètes.
   Mise en page exclusivement en tableaux (rendu fiable sous Dompdf). */

/* Pas de reset universel `* { margin: 0 }` : Dompdf l'applique aussi au
   contexte @page et annule les marges de page. */
body,
p, h1, h2, h3, h4, div, table, tr, td, th, ul, ol, li, span, img {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', 'Helvetica', sans-serif;
    font-size: 11px;
    line-height: 1.55;
    color: #2b3540;
    background: #ffffff;
}

@page {
    size: A4;
    margin: 22mm 18mm 22mm 18mm;
}

/* NB : pas de @page :first — Dompdf l'applique à toutes les pages.
   La couverture déborde via les marges négatives de .cover-page. */

.page-break {
    page-break-before: always;
}

/* ---------- En-tête / pied de page répétés ----------
   Dessinés par le script text/php du template (coordonnées absolues) :
   Dompdf clippe les éléments position:fixed placés dans les marges. */

/* ---------- Page de couverture ---------- */
.cover-page {
    /* Marges négatives = débord plein cadre sur la marge @page (22mm/18mm) */
    margin: -22mm -18mm 0 -18mm;
    page-break-after: always;
}

.cover-topbar {
    background: #1b4f72;
    height: 8px;
}

.cover-head {
    padding: 44px 55px 26px 55px;
    border-bottom: 2.5px solid #1b4f72;
}

.cover-head table {
    width: 100%;
    border-collapse: collapse;
}

.cover-logo {
    width: 110px;
}

.cover-logo img {
    width: 92px;
    height: 52px;
    object-fit: contain;
}

.cover-spacer {
    width: 110px;
}

.cover-title {
    text-align: center;
    vertical-align: middle;
}

.cover-title h1 {
    color: #1b4f72;
    font-size: 23px;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
}

.cover-title .cover-subtitle {
    color: #8a97a5;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.cover-body {
    padding: 45px 55px 30px 55px;
}

.cover-section-title {
    font-size: 11px;
    color: #1b4f72;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    border-bottom: 2px solid #1b4f72;
    padding-bottom: 6px;
    margin-bottom: 14px;
}

table.info-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 30px;
}

table.info-table td {
    padding: 7px 10px;
    border-bottom: 1px solid #e8ecf0;
    font-size: 11.5px;
    vertical-align: top;
}

table.info-table td.info-label {
    width: 38%;
    color: #5a6a75;
    font-weight: 600;
}

table.info-table td.info-value {
    color: #2b3540;
    text-transform: capitalize;
}

table.info-table td.info-value.info-value--raw {
    text-transform: none;
}

.certificate-box {
    border: 1.5px solid #1b4f72;
    padding: 22px 26px;
    margin-top: 34px;
    background: #f7fafc;
}

.certificate-box .certificate-title {
    font-size: 10px;
    color: #1b4f72;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    margin-bottom: 10px;
    text-align: center;
}

.certificate-box p {
    font-size: 12px;
    color: #2b3540;
    line-height: 1.7;
    text-align: center;
    margin-bottom: 8px;
}

.certificate-box p:last-child {
    margin-bottom: 0;
}

/* ---------- Titres de section (pages intérieures) ---------- */
.section-title {
    font-size: 15px;
    color: #1b4f72;
    font-weight: 700;
    margin-bottom: 4px;
    padding: 7px 10px;
}

.section-subtitle {
    font-size: 10px;
    color: #8a97a5;
    margin-bottom: 18px;
    padding: 7px 10px;
}

/* ---------- Synthèse ---------- */
table.summary-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 26px;
    border: 1px solid #d9dee3;
}

table.summary-table td {
    width: 33.33%;
    padding: 12px 14px;
    border-left: 1px solid #d9dee3;
    text-align: center;
    vertical-align: top;
}

table.summary-table td:first-child {
    border-left: none;
}

.summary-value {
    font-size: 20px;
    font-weight: 700;
    color: #1b4f72;
}

.summary-label {
    font-size: 9px;
    color: #5a6a75;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 2px;
}

/* ---------- Thèmes / compétences ---------- */
.theme-block {
    margin-bottom: 20px;
}

table.skills-table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid #d9dee3;
    border-bottom: 1px solid #d9dee3;
}

table.skills-table tr {
    page-break-inside: avoid;
    break-inside: avoid;
}

table.skills-table th.theme-heading-cell {
    background: #1b4f72;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: left;
    padding: 8px 14px;
    border-bottom: none;
}

table.skills-table th {
    background: #eef2f5;
    color: #5a6a75;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    text-align: left;
    padding: 6px 14px;
    border-bottom: 1px solid #d9dee3;
}

table.skills-table td {
    padding: 8px 14px;
    border-bottom: 1px solid #e8ecf0;
    font-size: 10.5px;
    vertical-align: top;
}

table.skills-table tr:last-child td {
    border-bottom: none;
}

.skill-title {
    font-weight: 600;
    color: #2b3540;
}

.skill-desc {
    font-size: 9.5px;
    color: #5a6a75;
    margin-top: 2px;
}

.cell-date {
    white-space: nowrap;
    color: #5a6a75;
    font-size: 10px;
}

.cell-empty {
    color: #b0bac3;
}

/* ---------- Pastilles de statut ---------- */
.status-chip {
    display: inline-block;
    font-size: 8.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 9px;
    border-radius: 10px;
    border: 1px solid;
    white-space: nowrap;
}

.status-validated {
    color: #1e7e34;
    border-color: #b7dfb8;
    background: #f0f9f0;
}

.status-awaiting {
    color: #9a6b00;
    border-color: #ecd9a0;
    background: #fdf6e0;
}

.status-pending {
    color: #5a6a75;
    border-color: #d9dee3;
    background: #f2f4f6;
}

/* ---------- Journal des actions ---------- */
table.journal-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #d9dee3;
}

table.journal-table th {
    background: #1b4f72;
    color: #ffffff;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    text-align: left;
    padding: 8px 14px;
}

table.journal-table td {
    padding: 12px 14px;
    border-bottom: 1px solid #e8ecf0;
    font-size: 10px;
    vertical-align: top;
}

table.journal-table tr {
    page-break-inside: avoid;
    break-inside: avoid;
}

table.journal-table {
    table-layout: fixed;
}

.journal-date {
    width: 62px;
    color: #5a6a75;
    font-weight: 600;
    white-space: nowrap;
}

.journal-module {
    font-weight: 700;
    color: #1b4f72;
    font-size: 11px;
}

.journal-desc {
    color: #5a6a75;
    margin-top: 4px;
}

.journal-comment {
    width: 100%;
    box-sizing: border-box;
    margin-top: 7px;
    padding: 8px 12px;
    background: #f7fafc;
    border-left: 3px solid #1b4f72;
    color: #2b3540;
    line-height: 1.55;
}

.journal-comment .comment-author {
    display: block;
    font-weight: 700;
    color: #1b4f72;
    font-size: 8.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 3px;
}

.journal-comment.agent {
    border-left-color: #8a97a5;
}

.journal-comment.agent .comment-author {
    color: #5a6a75;
}

.journal-status {
    width: 88px;
    text-align: center;
}

.journal-validation {
    width: 132px;
    color: #5a6a75;
    font-size: 9.5px;
}

/* ---------- Page de signatures ---------- */
.signature-intro {
    font-size: 11px;
    color: #2b3540;
    line-height: 1.7;
    padding: 14px 16px;
    background: #f7fafc;
    border-left: 3px solid #1b4f72;
    margin-bottom: 34px;
}

table.signature-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 14px 0;
    margin-top: 30px;
}

table.signature-table td.signature-cell {
    width: 33.33%;
    border: 1px solid #d9dee3;
    padding: 16px;
    vertical-align: top;
    height: 150px;
}

.signature-role {
    font-size: 10px;
    color: #1b4f72;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    margin-bottom: 6px;
}

.signature-name {
    font-size: 11px;
    color: #2b3540;
    margin-bottom: 3px;
}

.signature-function {
    font-size: 9px;
    color: #8a97a5;
    font-style: italic;
}

.signature-line {
    border-bottom: 1px solid #2b3540;
    margin-top: 60px;
    margin-bottom: 4px;
}

.signature-hint {
    font-size: 8px;
    color: #8a97a5;
    font-style: italic;
    text-align: center;
}

/* ---------- Divers ---------- */
.no-data {
    padding: 24px;
    color: #8a97a5;
    font-style: italic;
    text-align: center;
    border: 1px dashed #d9dee3;
    margin-bottom: 20px;
}

@media print {
    .theme-block,
    table.journal-table tr {
        break-inside: avoid;
        page-break-inside: avoid;
    }

    h1, h2, h3 {
        break-after: avoid;
        page-break-after: avoid;
    }
}
