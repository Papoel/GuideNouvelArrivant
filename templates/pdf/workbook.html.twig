<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Carnet de Compagnonnage — {{ user.fullname }}</title>
    <style>
        {% include 'pdf/css_workbook.twig' %}
    </style>
</head>
<body>

    {# En-tête, pied de page et pagination dessinés en coordonnées absolues
       via le script PHP embarqué de Dompdf. Le conteneur position:fixed est
       répété par Dompdf sur CHAQUE page : le script s'y réévalue à chaque
       page avec le bon $PAGE_NUM. Placé en premier, il couvre la couverture. #}
    <div style="position: fixed; top: 0; left: 0;">
    <script type="text/php">
        if (isset($pdf)) {
            $font = $fontMetrics->getFont('helvetica', 'normal');
            $gray = [0.54, 0.59, 0.65];
            $rule = [0.85, 0.87, 0.89];
            $left = 51;   // marge 18mm en points
            $right = 544; // 595pt - 51pt

            // En-tête répété (pages intérieures uniquement — la couverture
            // a son propre bandeau) : libellé à gauche, bénéficiaire à droite
            if ($PAGE_NUM > 1) {
                $pdf->text($left, 44, 'CARNET DE COMPAGNONNAGE', $font, 7, $gray);
                $who = {{ user.fullname|json_encode(constant('JSON_UNESCAPED_UNICODE') + constant('JSON_UNESCAPED_SLASHES'))|raw }};
                $pdf->text($right - $fontMetrics->getTextWidth($who, $font, 8), 44, $who, $font, 8, $gray);
                $pdf->line($left, 50, $right, 50, $rule, 0.5);
            }

            // Pied de page sur TOUTES les pages : filet, mention légale à
            // gauche, pagination à droite
            $pdf->line($left, 792, $right, 792, $rule, 0.5);
            $pdf->text($left, 805, {{ ('Document généré le ' ~ date_generation|date('d/m/Y à H:i', 'Europe/Paris') ~ ' - Usage interne')|json_encode(constant('JSON_UNESCAPED_UNICODE') + constant('JSON_UNESCAPED_SLASHES'))|raw }}, $font, 8, $gray);
            // $PAGE_COUNT est incrémental pendant le rendu : le total final
            // est injecté par le service après un premier passage de comptage.
            $page = "Page {$PAGE_NUM} sur {{ total_pages|default('?') }}";
            $pdf->text($right - $fontMetrics->getTextWidth($page, $font, 8), 805, $page, $font, 8, $gray);
        }
    </script>
    </div>

    {# ======================= PAGE DE COUVERTURE ======================= #}
    <div class="cover-page">
        <div class="cover-topbar"></div>
        <div class="cover-head">
            <table>
                <tr>
                    <td class="cover-logo">
                        {% if logo_path is defined and logo_path %}
                            <img src="{{ logo_path }}" alt="Logo EDF">
                        {% endif %}
                    </td>
                    <td class="cover-title">
                        <h1>CARNET DE COMPAGNONNAGE</h1>
                        <div class="cover-subtitle">Parcours de professionnalisation</div>
                    </td>
                    <td class="cover-spacer"></td>
                </tr>
            </table>
        </div>

        <div class="cover-body">
            <div class="cover-section-title">Informations du bénéficiaire</div>

            <table class="info-table">
                <tr>
                    <td class="info-label">Nom complet</td>
                    <td class="info-value">{{ user.fullname }}</td>
                </tr>
                <tr>
                    <td class="info-label">NNI</td>
                    <td class="info-value">{{ user.nni ?? '-' }}</td>
                </tr>
                <tr>
                    <td class="info-label">Adresse électronique</td>
                    <td class="info-value info-value--raw">{{ user.email }}</td>
                </tr>
                <tr>
                    <td class="info-label">Métier</td>
                    <td class="info-value">{{ user.job ? user.job.name : '-' }}</td>
                </tr>
                <tr>
                    <td class="info-label">Spécialité</td>
                    <td class="info-value">{{ user.speciality ? user.speciality.name : '-' }}</td>
                </tr>
                <tr>
                    <td class="info-label">Service d'affectation</td>
                    <td class="info-value">{{ user.service ? user.service.name : '—' }}</td>
                </tr>
                <tr>
                    <td class="info-label">Date de prise de poste</td>
                    <td class="info-value">{{ user.hiringAt ? user.hiringAt|date('d/m/Y') : '—' }}</td>
                </tr>
                <tr>
                    <td class="info-label">Tuteur référent</td>
                    <td class="info-value">{{ user.mentor ? user.mentor.fullname : (logbook.mentorName ?? '—') }}</td>
                </tr>
            </table>

            <div class="certificate-box">
                <div class="certificate-title">Attestation de suivi de formation</div>
                <p>
                    Le présent document atteste du suivi du parcours de compagnonnage de
                    <strong>{{ user.fullname }}</strong> pour le métier de
                    <strong>{{ user.job ? user.job.name : 'non spécifié' }}</strong>{% if user.speciality %},
                    spécialité <strong>{{ user.speciality.name }}</strong>{% endif %}.
                </p>
                <p>
                    Il consolide l'état des auto-validations de l'apprenant et des
                    validations prononcées par le tuteur référent.
                </p>
            </div>
        </div>

    </div>

    {# ======================= SYNTHÈSE & COMPÉTENCES ======================= #}
    <div class="section-title">Synthèse de la progression</div>
    <div class="section-subtitle">État des validations au {{ date_generation|date('d/m/Y') }}</div>

    <table class="summary-table">
        <tr>
            <td>
                <div class="summary-value">{{ progress.completed_by_agent }}/{{ progress.total_modules }}</div>
                <div class="summary-label">Modules auto-validés</div>
            </td>
            <td>
                <div class="summary-value">{{ progress.validated_by_mentor }}/{{ progress.total_modules }}</div>
                <div class="summary-label">Modules validés par le tuteur</div>
            </td>
            <td>
                <div class="summary-value">{{ progress.mentor_progress }}%</div>
                <div class="summary-label">Progression tuteur</div>
            </td>
        </tr>
    </table>

    <div class="section-title">Compétences par domaine</div>
    <div class="section-subtitle">{{ logbook.name }}</div>

    {% if logbook.themes is defined and logbook.themes|length > 0 %}
        {% for theme in logbook.themes %}
            <div class="theme-block">
                <table class="skills-table">
                    <thead>
                        <tr>
                            <th colspan="4" class="theme-heading-cell">{{ theme.title }}</th>
                        </tr>
                        <tr>
                            <th>Compétence</th>
                            <th style="width: 110px;">Statut</th>
                            <th style="width: 85px;">Auto-valid.</th>
                            <th style="width: 85px;">Valid. tuteur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for module in theme.modules %}
                            {% set action = null %}
                            {% for userAction in user.actions %}
                                {% if userAction.module.id == module.id %}
                                    {% set action = userAction %}
                                {% endif %}
                            {% endfor %}
                            <tr>
                                <td>
                                    <div class="skill-title">{{ module.title }}</div>
                                    {% if module.description %}
                                        <div class="skill-desc">{{ module.description|html_to_text|nl2br }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if action and action.mentorValidatedAt %}
                                        <span class="status-chip status-validated">Validée</span>
                                    {% elseif action and action.agentValidatedAt %}
                                        <span class="status-chip status-awaiting">En attente</span>
                                    {% else %}
                                        <span class="status-chip status-pending">Non débutée</span>
                                    {% endif %}
                                </td>
                                <td class="cell-date">
                                    {% if action and action.agentValidatedAt %}
                                        {{ action.agentValidatedAt|date('d/m/Y') }}
                                    {% else %}
                                        <span class="cell-empty">—</span>
                                    {% endif %}
                                </td>
                                <td class="cell-date">
                                    {% if action and action.mentorValidatedAt %}
                                        {{ action.mentorValidatedAt|date('d/m/Y') }}
                                    {% else %}
                                        <span class="cell-empty">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endfor %}
    {% else %}
        <div class="no-data">Aucun thème disponible dans ce carnet.</div>
    {% endif %}

    {# ======================= JOURNAL DES ACTIONS ======================= #}
    <div class="page-break"></div>

    <div class="section-title">Journal des actions</div>
    <div class="section-subtitle">Description, commentaires et visas associés à chaque module</div>

    {% if logbook.actions is defined and logbook.actions|length > 0 %}
        <table class="journal-table">
            <thead>
                <tr>
                    <th style="width: 11%;">Date</th>
                    <th style="width: 47%;">Module et détail</th>
                    <th style="width: 16%; text-align: center;">Statut</th>
                    <th style="width: 26%;">Validation tuteur</th>
                </tr>
            </thead>
            <tbody>
                {% for action in logbook.actions %}
                    <tr>
                        <td class="journal-date">
                            {{ action.agentValidatedAt ? action.agentValidatedAt|date('d/m/Y') : '—' }}
                        </td>
                        <td>
                            <div class="journal-module">{{ action.module ? action.module.title : 'Action sans module' }}</div>
                            {% if action.description %}
                                <div class="journal-desc">{{ action.description|html_to_text|nl2br }}</div>
                            {% endif %}
                            {% if action.agentComment %}
                                <div class="journal-comment agent">
                                    <span class="comment-author">Apprenant</span>
                                    {{ action.agentComment|html_to_text|nl2br }}
                                </div>
                            {% endif %}
                            {% if action.mentorComment %}
                                <div class="journal-comment">
                                    <span class="comment-author">Tuteur{% if action.mentorCommentedAt %} — {{ action.mentorCommentedAt|date('d/m/Y') }}{% endif %}</span>
                                    {{ action.mentorComment|html_to_text|nl2br }}
                                </div>
                            {% endif %}
                        </td>
                        <td class="journal-status">
                            {% if action.mentorValidatedAt %}
                                <span class="status-chip status-validated">Validée</span>
                            {% elseif action.agentValidatedAt %}
                                <span class="status-chip status-awaiting">Auto-validée</span>
                            {% else %}
                                <span class="status-chip status-pending">En attente</span>
                            {% endif %}
                        </td>
                        <td class="journal-validation">
                            {% if action.mentorValidatedAt %}
                                {{ action.mentorValidatedAt|date('d/m/Y') }}
                                {% if action.mentorVisa %}<br>{{ action.mentorVisa }}{% endif %}
                            {% else %}
                                <span class="cell-empty">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="no-data">Aucune action enregistrée dans ce carnet.</div>
    {% endif %}

    {# ======================= PAGE DE SIGNATURES ======================= #}
    <div class="page-break"></div>

    <div class="section-title">Validation du parcours</div>
    <div class="section-subtitle">Signatures des parties prenantes</div>

    <div class="signature-intro">
        Le soussigné atteste que le parcours de compagnonnage de
        <strong>{{ user.fullname }}</strong> a été suivi conformément au référentiel
        métier de <strong>{{ user.job ? user.job.name : 'non spécifié' }}</strong>{% if user.speciality %},
        spécialité <strong>{{ user.speciality.name }}</strong>{% endif %}.
        Les signatures ci-dessous valident l'acquisition des compétences
        consignées dans le présent document.
    </div>

    <table class="signature-table">
        <tr>
            <td class="signature-cell">
                <div class="signature-role">L'apprenant</div>
                <div class="signature-name">{{ user.fullname }}</div>
                <div class="signature-function">Bénéficiaire de la formation</div>
                <div class="signature-line"></div>
                <div class="signature-hint">Signature et date</div>
            </td>
            <td class="signature-cell">
                <div class="signature-role">Le tuteur</div>
                <div class="signature-name">{{ user.mentor ? user.mentor.fullname : (logbook.mentorName ?? '—') }}</div>
                <div class="signature-function">Tuteur référent</div>
                <div class="signature-line"></div>
                <div class="signature-hint">Signature et date</div>
            </td>
            <td class="signature-cell">
                <div class="signature-role">Le chef de service</div>
                <div class="signature-name">{{ user.service and user.service.chef ? user.service.chef.fullname : '—' }}</div>
                <div class="signature-function">Responsable de service</div>
                <div class="signature-line"></div>
                <div class="signature-hint">Signature et date</div>
            </td>
        </tr>
    </table>

</body>
</html>
